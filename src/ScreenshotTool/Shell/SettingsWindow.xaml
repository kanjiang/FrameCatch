<Window x:Class="ScreenshotTool.Shell.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置"
        Width="560"
        Height="440"
        MinWidth="520"
        MinHeight="400"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Margin="0,0,0,16"
                   FontSize="20"
                   FontWeight="SemiBold"
                   Text="设置" />

        <GroupBox Grid.Row="1"
                  Header="热键"
                  Margin="0,0,0,12">
            <Grid Margin="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Column="0"
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Orientation="Vertical"
                            Margin="0,0,16,0">
                    <CheckBox x:Name="CtrlModifierCheckBox"
                              Content="Ctrl"
                              Margin="0,0,0,6" />
                    <CheckBox x:Name="AltModifierCheckBox"
                              Content="Alt"
                              Margin="0,0,0,6" />
                    <CheckBox x:Name="ShiftModifierCheckBox"
                              Content="Shift"
                              Margin="0,0,0,6" />
                    <CheckBox x:Name="WinModifierCheckBox"
                              Content="Win" />
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            VerticalAlignment="Center">
                    <TextBlock Margin="0,0,0,6"
                               Foreground="#FF4A5568"
                               Text="主键" />
                    <TextBox x:Name="HotkeyKeyTextBox"
                             Width="180"
                             Height="30"
                             Padding="8,4"
                             IsReadOnly="True"
                             PreviewKeyDown="HotkeyKeyTextBox_PreviewKeyDown" />
                    <TextBlock Margin="0,6,0,0"
                               Foreground="#FF718096"
                               Text="点击后按下想要的按键。" />
                </StackPanel>

                <Button Grid.Column="2"
                        Grid.Row="0"
                        Grid.RowSpan="2"
                        VerticalAlignment="Center"
                        Padding="12,6"
                        Content="恢复默认"
                        Click="ResetHotkeyButton_Click" />
            </Grid>
        </GroupBox>

        <GroupBox Grid.Row="2"
                  Header="默认保存目录"
                  Margin="0,0,0,12">
            <Grid Margin="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="SaveDirectoryTextBox"
                         Grid.Column="0"
                         Height="30"
                         Padding="8,4"
                         Margin="0,0,10,0" />
                <Button Grid.Column="1"
                        Padding="12,6"
                        Content="浏览..."
                        Click="BrowseDirectoryButton_Click" />
            </Grid>
        </GroupBox>

        <GroupBox Grid.Row="3"
                  Header="默认标注样式"
                  Margin="0,0,0,12">
            <Grid Margin="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"
                           Foreground="#FF4A5568"
                           Text="颜色" />
                <ComboBox x:Name="StrokeColorComboBox"
                          Grid.Column="1"
                          Height="30"
                          Padding="4,2">
                    <ComboBoxItem Content="红色"
                                  Tag="#FF0000"
                                  IsSelected="True" />
                    <ComboBoxItem Content="黄色"
                                  Tag="#FFF6C744" />
                    <ComboBoxItem Content="绿色"
                                  Tag="#FF16A34A" />
                    <ComboBoxItem Content="蓝色"
                                  Tag="#FF2563EB" />
                    <ComboBoxItem Content="黑色"
                                  Tag="#FF111827" />
                    <ComboBoxItem Content="白色"
                                  Tag="#FFFFFFFF" />
                </ComboBox>

                <TextBlock Grid.Column="2"
                           VerticalAlignment="Center"
                           Margin="16,0,8,0"
                           Foreground="#FF4A5568"
                           Text="线宽" />
                <ComboBox x:Name="StrokeThicknessComboBox"
                          Grid.Column="3"
                          Height="30"
                          Padding="4,2">
                    <ComboBoxItem Content="2 px"
                                  Tag="2" />
                    <ComboBoxItem Content="3 px"
                                  Tag="3"
                                  IsSelected="True" />
                    <ComboBoxItem Content="4 px"
                                  Tag="4" />
                    <ComboBoxItem Content="6 px"
                                  Tag="6" />
                    <ComboBoxItem Content="8 px"
                                  Tag="8" />
                    <ComboBoxItem Content="12 px"
                                  Tag="12" />
                </ComboBox>
            </Grid>
        </GroupBox>

        <TextBlock Grid.Row="4"
                   Foreground="#FF718096"
                   TextWrapping="Wrap"
                   VerticalAlignment="Top"
                   Text="保存后会立即重新注册热键；如果新热键被占用，应用会恢复到之前的热键设置。" />

        <StackPanel Grid.Row="5"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="取消"
                    MinWidth="88"
                    Padding="16,8"
                    Margin="0,0,8,0"
                    IsCancel="True" />
            <Button Content="保存"
                    MinWidth="88"
                    Padding="16,8"
                    IsDefault="True"
                    Click="SaveButton_Click" />
        </StackPanel>
    </Grid>
</Window>
