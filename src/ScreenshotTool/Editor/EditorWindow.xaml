<Window x:Class="ScreenshotTool.Editor.EditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="截图标注"
        Width="640"
        Height="480"
        MinWidth="320"
        MinHeight="240"
        WindowStartupLocation="Manual"
        SizeToContent="Manual"
        SourceInitialized="Window_SourceInitialized"
        Loaded="Window_Loaded"
        PreviewKeyDown="Window_PreviewKeyDown"
        Closing="Window_Closing">
    <DockPanel Background="#FFF4F6F8">
        <Border x:Name="ToolbarBorder"
                DockPanel.Dock="Top"
                Background="White"
                BorderBrush="#FFD8DEE6"
                BorderThickness="0,0,0,1"
                Padding="10,8">
            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled"
                          CanContentScroll="False">
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center">
                <RadioButton x:Name="SelectToolButton"
                             GroupName="Tools"
                             Tag="Select"
                             Content="选择"
                             Margin="0,0,8,0"
                             Padding="10,6"
                             IsChecked="True"
                             Checked="ToolButton_Checked" />
                <RadioButton GroupName="Tools"
                             Tag="Rectangle"
                             Content="矩形"
                             Margin="0,0,8,0"
                             Padding="10,6"
                             Checked="ToolButton_Checked" />
                <RadioButton GroupName="Tools"
                             Tag="Ellipse"
                             Content="椭圆"
                             Margin="0,0,8,0"
                             Padding="10,6"
                             Checked="ToolButton_Checked" />
                <RadioButton GroupName="Tools"
                             Tag="Arrow"
                             Content="箭头"
                             Margin="0,0,8,0"
                             Padding="10,6"
                             Checked="ToolButton_Checked" />
                <RadioButton GroupName="Tools"
                             Tag="Pen"
                             Content="画笔"
                             Margin="0,0,8,0"
                             Padding="10,6"
                             Checked="ToolButton_Checked" />
                <RadioButton GroupName="Tools"
                             Tag="Highlighter"
                             Content="荧光笔"
                             Margin="0,0,8,0"
                             Padding="10,6"
                             Checked="ToolButton_Checked" />
                <RadioButton GroupName="Tools"
                             Tag="Text"
                             Content="文字"
                             Margin="0,0,16,0"
                             Padding="10,6"
                             Checked="ToolButton_Checked" />

                <TextBlock Margin="0,0,6,0"
                           VerticalAlignment="Center"
                           Foreground="#FF4A5568"
                           Text="颜色" />
                <ComboBox x:Name="ColorComboBox"
                          Width="132"
                          Margin="0,0,12,0"
                          VerticalAlignment="Center"
                          SelectionChanged="ColorComboBox_SelectionChanged">
                    <ComboBoxItem Content="红色"
                                  Tag="#FFE53E3E"
                                  IsSelected="True" />
                    <ComboBoxItem Content="黄色"
                                  Tag="#FFF6C744" />
                    <ComboBoxItem Content="绿色"
                                  Tag="#FF16A34A" />
                    <ComboBoxItem Content="蓝色"
                                  Tag="#FF2563EB" />
                    <ComboBoxItem Content="黑色"
                                  Tag="#FF111827" />
                    <ComboBoxItem Content="白色"
                                  Tag="#FFFFFFFF" />
                </ComboBox>

                <TextBlock Margin="0,0,6,0"
                           VerticalAlignment="Center"
                           Foreground="#FF4A5568"
                           Text="线宽" />
                <ComboBox x:Name="ThicknessComboBox"
                          Width="92"
                          Margin="0,0,16,0"
                          VerticalAlignment="Center"
                          SelectionChanged="ThicknessComboBox_SelectionChanged">
                    <ComboBoxItem Content="2 px"
                                  Tag="2" />
                    <ComboBoxItem Content="4 px"
                                  Tag="4"
                                  IsSelected="True" />
                    <ComboBoxItem Content="6 px"
                                  Tag="6" />
                    <ComboBoxItem Content="8 px"
                                  Tag="8" />
                    <ComboBoxItem Content="12 px"
                                  Tag="12" />
                </ComboBox>

                <TextBlock Margin="0,0,6,0"
                           VerticalAlignment="Center"
                           Foreground="#FF4A5568"
                           Text="字号" />
                <ComboBox x:Name="FontSizeComboBox"
                          Width="92"
                          Margin="0,0,16,0"
                          VerticalAlignment="Center"
                          SelectionChanged="FontSizeComboBox_SelectionChanged">
                    <ComboBoxItem Content="12"
                                  Tag="12" />
                    <ComboBoxItem Content="16"
                                  Tag="16" />
                    <ComboBoxItem Content="20"
                                  Tag="20" />
                    <ComboBoxItem Content="24"
                                  Tag="24"
                                  IsSelected="True" />
                    <ComboBoxItem Content="32"
                                  Tag="32" />
                    <ComboBoxItem Content="48"
                                  Tag="48" />
                </ComboBox>

                <Button x:Name="UndoButton"
                        Content="撤销"
                        Margin="0,0,8,0"
                        Padding="12,6"
                        Click="UndoButton_Click" />
                <Button x:Name="RedoButton"
                        Content="重做"
                        Margin="0,0,16,0"
                        Padding="12,6"
                        Click="RedoButton_Click" />

                <TextBlock x:Name="HintTextBlock"
                           VerticalAlignment="Center"
                           Foreground="#FF718096"
                           Text="Ctrl+Z 撤销，Ctrl+Y 重做，Delete 删除选中标注" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Border x:Name="FooterBorder"
                DockPanel.Dock="Bottom"
                Background="White"
                BorderBrush="#FFD8DEE6"
                BorderThickness="0,1,0,0"
                Padding="12">
            <DockPanel LastChildFill="False">
                <TextBlock x:Name="StatusTextBlock"
                           DockPanel.Dock="Left"
                           VerticalAlignment="Center"
                           Foreground="#FF4A5568"
                           Text="准备就绪" />
                <StackPanel DockPanel.Dock="Right"
                            Orientation="Horizontal">
                    <Button Content="复制"
                            Margin="0,0,8,0"
                            Padding="18,8"
                            Click="CopyButton_Click" />
                    <Button Content="保存"
                            Margin="0,0,8,0"
                            Padding="18,8"
                            Click="SaveButton_Click" />
                    <Button Content="复制并保存"
                            Margin="0,0,8,0"
                            Padding="18,8"
                            Click="CopyAndSaveButton_Click" />
                    <Button Content="关闭"
                            Padding="18,8"
                            Click="CloseButton_Click" />
                </StackPanel>
            </DockPanel>
        </Border>

        <ScrollViewer x:Name="CanvasScrollViewer"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto"
                      Padding="12">
            <Border x:Name="CanvasHost"
                    Background="White"
                    BorderBrush="#FFD8DEE6"
                    BorderThickness="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    SnapsToDevicePixels="True" />
        </ScrollViewer>
    </DockPanel>
</Window>
