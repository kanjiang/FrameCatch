<Window x:Class="ScreenshotTool.Capture.CaptureOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="截图"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="True"
        Topmost="True"
        Focusable="True"
        WindowStartupLocation="Manual"
        KeyDown="Window_KeyDown"
        MouseRightButtonUp="Window_MouseRightButtonUp">
    <Grid x:Name="RootGrid" Background="Transparent">
        <Image x:Name="BackgroundImage"
               Stretch="Fill"
               SnapsToDevicePixels="True"
               RenderOptions.BitmapScalingMode="NearestNeighbor" />

        <Canvas x:Name="SelectionCanvas"
                Background="Transparent"
                MouseLeftButtonDown="SelectionCanvas_MouseLeftButtonDown"
                MouseLeftButtonUp="SelectionCanvas_MouseLeftButtonUp"
                MouseMove="SelectionCanvas_MouseMove"
                SizeChanged="SelectionCanvas_SizeChanged">
            <Path x:Name="OverlayPath"
                  Fill="#99000000"
                  IsHitTestVisible="False" />

            <Path x:Name="SelectionShape"
                  Visibility="Collapsed"
                  Fill="#22007ACC"
                  Stroke="White"
                  StrokeThickness="2"
                  StrokeLineJoin="Round"
                  IsHitTestVisible="False" />

            <Polyline x:Name="LassoPreview"
                      Visibility="Collapsed"
                      Stroke="White"
                      StrokeThickness="2"
                      StrokeLineJoin="Round"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"
                      IsHitTestVisible="False" />

            <Border x:Name="SelectionInfoBadge"
                    Visibility="Collapsed"
                    Background="#CC111111"
                    CornerRadius="6"
                    Padding="8,4"
                    IsHitTestVisible="False">
                <TextBlock x:Name="SelectionInfoText"
                           Foreground="White"
                           FontSize="12"
                           FontWeight="SemiBold" />
            </Border>

            <Border x:Name="ConfirmBar"
                    Visibility="Collapsed"
                    Background="#E6191919"
                    BorderBrush="#44FFFFFF"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="10,8">
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="ConfirmButton"
                            Click="ConfirmButton_Click"
                            Content="确认"
                            MinWidth="72"
                            Margin="0,0,8,0"
                            Padding="12,6" />
                    <Button x:Name="ReselectButton"
                            Click="ReselectButton_Click"
                            Content="重选"
                            MinWidth="72"
                            Margin="0,0,12,0"
                            Padding="12,6" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="ConfirmInfoText"
                                   Foreground="White"
                                   FontSize="12"
                                   FontWeight="SemiBold" />
                        <TextBlock Foreground="#CCFFFFFF"
                                   FontSize="11"
                                   Text="双击或 Enter 确认，Esc 取消" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Canvas>

        <Border HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,20,0,0"
                Background="#CC111111"
                BorderBrush="#44FFFFFF"
                BorderThickness="1"
                CornerRadius="12"
                Padding="12,8">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="RectangleModeButton"
                        Click="RectangleModeButton_Click"
                        Content="矩形 (R)"
                        MinWidth="92"
                        Margin="0,0,8,0"
                        Padding="12,6" />
                <Button x:Name="LassoModeButton"
                        Click="LassoModeButton_Click"
                        Content="套索 (F)"
                        MinWidth="92"
                        Margin="0,0,12,0"
                        Padding="12,6" />
                <TextBlock VerticalAlignment="Center"
                           Foreground="White"
                           FontSize="12"
                           Text="右键或 Esc 取消" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
